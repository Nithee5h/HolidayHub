# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# 5050 avoids macOS AirPlay Receiver, which occupies port 5000
PORT=5050
# MongoDB Atlas or local connection string (credentials stay in .env only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=holidayhub
# Comma-separated browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
APP_TIMEZONE=Asia/Kolkata
# Session signing secret (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7
# lax for same-site setups; none (+ COOKIE_SECURE=true) when client and API are on different sites
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true in production
# Reverse proxies in front of the API (for correct client IPs in rate limits)
TRUST_PROXY=1
# Used only by `npm run seed:admin` to create the first admin account
ADMIN_NAME=HolidayHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
